# ============================================================
#  Variables de entorno — Tienda (Next.js + Supabase + Stripe)
#  Copia este archivo como .env.local y completa los valores.
# ============================================================

# --- Supabase (públicas, disponibles en el cliente) ---
NEXT_PUBLIC_SUPABASE_URL="https://ydcdhphsrphglewfmbwl.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_o_anon_key"

# --- Supabase (secreta, solo servidor: webhooks, tareas admin) ---
SUPABASE_SERVICE_ROLE_KEY="service_role_key"

# --- Stripe (opcional) ---
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Wompi (Colombia) ---
# Con estas variables el checkout usa Wompi (redirect). Sin ellas, pago simulado.
# El ambiente (sandbox/producción) se deduce del prefijo de la llave pública.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_xxx"     # pub_test_ (sandbox) | pub_prod_ (producción)
WOMPI_PRIVATE_KEY="prv_test_xxx"
WOMPI_INTEGRITY_SECRET="test_integrity_xxx"     # Dashboard Wompi → Secretos de integración
WOMPI_EVENTS_SECRET="test_events_xxx"           # Dashboard Wompi → Secretos de integración
# Webhook a configurar en Wompi: {NEXT_PUBLIC_SITE_URL}/api/webhooks/wompi

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
